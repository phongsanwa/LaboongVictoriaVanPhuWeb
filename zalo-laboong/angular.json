{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "zma-0001": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/zma-0001",
      "sourceRoot": "apps/zma-0001/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "outputPath": "dist/zma-0001",
            "index": "apps/zma-0001/src/index.html",
            "main": "apps/zma-0001/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/zma-0001/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/zma-0001/src/favicon.ico",
              "apps/zma-0001/src/assets",
              { "glob": "app-config.json", "input": "apps/zma-0001", "output": "/" }
            ],
            "styles": [
              "node_modules/swiper/swiper-bundle.css",
              "common/assets/css/all.min.css",
              "common/assets/css/phosphor/phosphor.css",
              "apps/zma-0001/src/styles.scss",
              "apps/zma-0001/src/styles/my.style.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "moment",
              "qrcode",
              "jsbarcode"
            ],
            "customWebpackConfig": {
              "path": "webpack.extra.js"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2mb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "none",
              "fileReplacements": [
                {
                  "replace": "apps/zma-0001/src/environments/environment.ts",
                  "with": "apps/zma-0001/src/environments/environment.prod.ts"
                }
              ],
              "index": "apps/zma-0001/src/index-pro.html"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "demo": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2mb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "none",
              "fileReplacements": [
                {
                  "replace": "apps/zma-0001/src/environments/environment.ts",
                  "with": "apps/zma-0001/src/environments/environment.demo.ts"
                }
              ],
              "index": "apps/zma-0001/src/index-pro.html"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "zma-0001:build:production"
            },
            "development": {
              "buildTarget": "zma-0001:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "zma-0001:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "apps/zma-0001/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "apps/zma-0001/src/favicon.ico",
              "apps/zma-0001/src/assets"
            ],
            "styles": [
              "node_modules/swiper/swiper-bundle.css",
              "apps/zma-0001/src/assets/css/all.min.css",
              "apps/zma-0001/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
